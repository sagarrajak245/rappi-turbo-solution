# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
# Leave empty to use the local SQLite fallback (backend/data/app.db).
# Local Docker:  postgresql://postgres:postgres@localhost:5432/rappi
# Supabase:      use the session pooler (5432) or direct URL. The transaction
#                pooler (6543) is supported (prepared statements are disabled).
DATABASE_URL=
# Optional direct (non-pooled) URL used by Alembic migrations.
DATABASE_URL_DIRECT=

# --- Redis (optional) -----------------------------------------------------
# Empty => in-memory cache, in-process worker and broadcaster.
REDIS_URL=

# --- LLM providers ----------------------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Langfuse (optional, off by default) -----------------------------------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- App ------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# Auth (dev defaults exist; set real values outside local dev)
AUTH__JWT_SECRET=
AUTH__COOKIE_SECURE=false
AUTH__SEED_BUYER_PASSWORD=
AUTH__SEED_ADMIN_PASSWORD=
